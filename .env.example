# Supabase (required — loaded by Expo as EXPO_PUBLIC_*)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI features (optional — server-side or secure storage recommended for production)
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key
EXPO_PUBLIC_REPLICATE_API_TOKEN=your_replicate_api_token
EXPO_PUBLIC_HUGGINGFACE_API_KEY=your_huggingface_api_key
